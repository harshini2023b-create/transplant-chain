# Server
PORT=5000

# AWS S3 — use an IAM user or role with access only to the target bucket.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace_with_your_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_your_secret_access_key
AWS_S3_BUCKET=replace_with_your_bucket_name

# Local blockchain deployment
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=replace_with_deployed_contract_address
BLOCKCHAIN_PRIVATE_KEY=replace_with_local_development_wallet_private_key
